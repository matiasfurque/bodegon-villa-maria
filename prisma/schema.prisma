generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique
  descripcion String?
  users       User[]
  permisos    RolePermiso[]
}

model Permiso {
  id          Int     @id @default(autoincrement())
  codigo      String  @unique
  nombre      String
  descripcion String?
  roles       RolePermiso[]
}

model RolePermiso {
  id        Int     @id @default(autoincrement())
  roleId    Int
  permisoId Int
  role      Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permiso   Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@unique([roleId, permisoId])
  @@index([permisoId])
}

model User {
  id             Int       @id @default(autoincrement())
  nombre         String
  apellido       String
  usuario        String    @unique
  passwordHash   String
  estadoId       Int       @default(1)
  telefono       String?
  email          String?
  roleId         Int
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  role           Role      @relation(fields: [roleId], references: [id])
  estado         UsuarioEstado @relation(fields: [estadoId], references: [id])
  pedidos        Pedido[]
  cuentasCerradas Cuenta[]
  mesasAbiertas  Mesa[]    @relation("MesaAbiertaPor")
  passwordResetTokens PasswordResetToken[]
}

model UsuarioEstado {
  id            Int     @id @default(autoincrement())
  codigo        String  @unique
  nombre        String
  descripcion   String?
  orden         Int     @default(0)
  permiteAcceso Boolean @default(false)
  users         User[]
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

model Mesa {
  id          Int       @id @default(autoincrement())
  numero      Int       @unique
  descripcion String?
  capacidad   Int
  estadoId    Int       @default(1)
  sectorId    Int?
  abiertaAt   DateTime?
  abiertaPor  Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  estado      MesaEstado @relation(fields: [estadoId], references: [id])
  sector      SectorMesa? @relation(fields: [sectorId], references: [id])
  abiertaPorUser User?   @relation("MesaAbiertaPor", fields: [abiertaPor], references: [id], onDelete: SetNull)
  pedidos     Pedido[]
  cuentas     Cuenta[]
}

model SectorMesa {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique
  descripcion String?
  orden       Int     @default(0)
  estadoId    Int     @default(1)
  estado      SectorMesaEstado @relation(fields: [estadoId], references: [id])
  mesas       Mesa[]
}

model SectorMesaEstado {
  id          Int     @id @default(autoincrement())
  codigo      String  @unique
  nombre      String
  descripcion String?
  orden       Int     @default(0)
  habilitado  Boolean @default(false)
  sectores    SectorMesa[]
}

model MesaEstado {
  id          Int     @id @default(autoincrement())
  codigo      String  @unique
  nombre      String
  descripcion String?
  orden       Int     @default(0)
  permitePedido Boolean @default(false)
  liberaMesa  Boolean @default(false)
  mesas       Mesa[]
}

model CategoriaProducto {
  id        Int        @id @default(autoincrement())
  nombre    String     @unique
  orden     Int?
  estadoId  Int        @default(1)
  estado    CategoriaProductoEstado @relation(fields: [estadoId], references: [id])
  productos Producto[]
}

model CategoriaProductoEstado {
  id            Int     @id @default(autoincrement())
  codigo        String  @unique
  nombre        String
  descripcion   String?
  orden         Int     @default(0)
  visibleEnMenu Boolean @default(false)
  habilitado    Boolean @default(false)
  categorias    CategoriaProducto[]
}

model Producto {
  id           Int       @id @default(autoincrement())
  nombre       String
  descripcion  String?
  precio       Decimal
  estadoId     Int       @default(1)
  visibilidadId Int      @default(1)
  categoriaId  Int
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  categoria    CategoriaProducto @relation(fields: [categoriaId], references: [id])
  estado       ProductoEstado @relation(fields: [estadoId], references: [id])
  visibilidad  ProductoVisibilidad @relation(fields: [visibilidadId], references: [id])
  items        PedidoItem[]
  cuentaDetalles CuentaDetalle[]
}

model ProductoEstado {
  id            Int     @id @default(autoincrement())
  codigo        String  @unique
  nombre        String
  descripcion   String?
  orden         Int     @default(0)
  permiteVenta  Boolean @default(false)
  esBajaLogica  Boolean @default(false)
  productos     Producto[]
}

model ProductoVisibilidad {
  id            Int     @id @default(autoincrement())
  codigo        String  @unique
  nombre        String
  descripcion   String?
  orden         Int     @default(0)
  visibleEnMenu Boolean @default(false)
  productos     Producto[]
}

model Pedido {
  id          Int       @id @default(autoincrement())
  mesaId      Int
  usuarioId   Int
  fechaHora   DateTime  @default(now())
  estadoId    Int       @default(1)
  estadoCocinaId Int    @default(1)
  observacion String?
  mesa        Mesa      @relation(fields: [mesaId], references: [id])
  usuario     User      @relation(fields: [usuarioId], references: [id])
  estado      PedidoEstado @relation(fields: [estadoId], references: [id])
  estadoCocina PedidoEstadoCocina @relation(fields: [estadoCocinaId], references: [id])
  items       PedidoItem[]
}

model PedidoEstado {
  id          Int     @id @default(autoincrement())
  codigo      String  @unique
  nombre      String
  descripcion String?
  orden       Int     @default(0)
  esActivo    Boolean @default(false)
  pedidos     Pedido[]
}

model PedidoEstadoCocina {
  id          Int     @id @default(autoincrement())
  codigo      String  @unique
  nombre      String
  descripcion String?
  orden       Int     @default(0)
  permiteAgregarItems Boolean @default(false)
  visibleCocina Boolean @default(true)
  notificaMozo Boolean @default(false)
  pedidos     Pedido[]
}

model PedidoItem {
  id             Int      @id @default(autoincrement())
  pedidoId       Int
  productoId     Int
  cantidad       Int
  precioUnitario Decimal
  subtotal       Decimal
  observacion    String?
  estadoId       Int      @default(1)
  motivoAnulacionId Int?
  motivoAnulacionDetalle String?
  pedido         Pedido   @relation(fields: [pedidoId], references: [id])
  producto       Producto @relation(fields: [productoId], references: [id])
  estado         PedidoItemEstado @relation(fields: [estadoId], references: [id])
  motivoAnulacion MotivoAnulacion? @relation(fields: [motivoAnulacionId], references: [id], onDelete: SetNull)
}

model PedidoItemEstado {
  id          Int     @id @default(autoincrement())
  codigo      String  @unique
  nombre      String
  descripcion String?
  orden       Int     @default(0)
  esAnulado   Boolean @default(false)
  items       PedidoItem[]
}

model MotivoAnulacion {
  id          Int     @id @default(autoincrement())
  codigo      String  @unique
  nombre      String
  descripcion String?
  estadoId    Int     @default(1)
  estado      MotivoAnulacionEstado @relation(fields: [estadoId], references: [id])
  items       PedidoItem[]
}

model MotivoAnulacionEstado {
  id          Int     @id @default(autoincrement())
  codigo      String  @unique
  nombre      String
  descripcion String?
  orden       Int     @default(0)
  habilitado  Boolean @default(false)
  motivos     MotivoAnulacion[]
}

model Cuenta {
  id              Int      @id @default(autoincrement())
  mesaId          Int
  usuarioCierreId Int
  fechaCierre     DateTime @default(now())
  total           Decimal
  metodoPagoId    Int      @default(1)
  montoRecibido   Decimal  @default(0)
  vuelto          Decimal  @default(0)
  estadoId        Int      @default(1)
  mesa            Mesa     @relation(fields: [mesaId], references: [id])
  usuarioCierre   User     @relation(fields: [usuarioCierreId], references: [id])
  metodoPago      MetodoPago @relation(fields: [metodoPagoId], references: [id])
  estado          CuentaEstado @relation(fields: [estadoId], references: [id])
  detalles        CuentaDetalle[]
}

model MetodoPago {
  id          Int     @id @default(autoincrement())
  codigo      String  @unique
  nombre      String
  descripcion String?
  orden       Int     @default(0)
  requiereMontoRecibido Boolean @default(false)
  estadoId    Int     @default(1)
  estado      MetodoPagoEstado @relation(fields: [estadoId], references: [id])
  cuentas     Cuenta[]
}

model MetodoPagoEstado {
  id          Int     @id @default(autoincrement())
  codigo      String  @unique
  nombre      String
  descripcion String?
  orden       Int     @default(0)
  habilitado  Boolean @default(false)
  metodosPago MetodoPago[]
}

model CuentaEstado {
  id          Int     @id @default(autoincrement())
  codigo      String  @unique
  nombre      String
  descripcion String?
  orden       Int     @default(0)
  esCerrada   Boolean @default(false)
  cuentas     Cuenta[]
}

model CuentaDetalle {
  id             Int      @id @default(autoincrement())
  cuentaId       Int
  pedidoId       Int?
  productoId     Int?
  productoNombre String
  cantidad       Int
  precioUnitario Decimal
  subtotal       Decimal
  observacion    String?
  cuenta         Cuenta   @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  producto       Producto? @relation(fields: [productoId], references: [id])

  @@index([cuentaId])
  @@index([productoId])
}
